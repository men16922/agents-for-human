{
  "$comment": "Permission boundary for the unattended overnight loop ONLY. Loaded via `claude -p --settings`; your interactive settings (~/.claude/settings.json, .claude/settings.local.json) are untouched. DENY beats ALLOW \u2014 the deny list is the real safety boundary. make targets are whitelisted explicitly (no blanket `Bash(make *)`) so a newly-added destructive target is NOT auto-allowed. ADAPT PER REPO: add your project's gate targets to allow, and your destructive/online targets (db/infra/deploy/serve) to deny.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Skill",
      "Bash(make check)",
      "Bash(make smoke-local)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(touch scripts/overnight/*)",
      "Bash(cd *)",
      "Bash(make overnight-where)",
      "Bash(python3 scripts/check.py*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Bash(rm -rf*)",
      "Bash(sudo *)",
      "Bash(make deploy*)",
      "Bash(make publish*)",
      "Bash(make release*)",
      "Bash(make db-*)",
      "Bash(make infra-*)",
      "WebFetch",
      "WebSearch",
      "mcp__github",
      "mcp__playwright",
      "Bash(make serve*)",
      "Bash(make dev*)",
      "Bash(make start*)",
      "Bash(make destroy*)",
      "Bash(make clean*)",
      "Bash(aws *)",
      "Bash(cdk *)",
      "Bash(terraform *)",
      "Bash(npx *)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(pip install*)",
      "Bash(pip3 install*)"
    ]
  },
  "enabledMcpjsonServers": []
}
