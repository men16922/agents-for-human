{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": {
      "*": "ask",
      "git push *": "deny",
      "git reset --hard *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "make deploy*": "deny",
      "make publish*": "deny",
      "make release*": "deny",
      "make db-*": "deny",
      "make infra-*": "deny",
      "make check": "allow",
      "make smoke-local": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "touch scripts/overnight/*": "allow",
      "make overnight-where": "allow",
      "python3 scripts/check.py*": "allow",
      "make serve*": "deny",
      "make dev*": "deny",
      "make start*": "deny",
      "make destroy*": "deny",
      "make clean*": "deny",
      "aws *": "deny",
      "cdk *": "deny",
      "terraform *": "deny",
      "npx *": "deny",
      "npm install*": "deny",
      "npm ci*": "deny",
      "pip install*": "deny",
      "pip3 install*": "deny"
    }
  }
}
