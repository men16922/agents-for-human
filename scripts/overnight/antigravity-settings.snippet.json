{
  "enableTerminalSandbox": true,
  "toolPermission": "proceed-in-sandbox",
  "permissions": {
    "allow": [
      "command(make check)",
      "command(make smoke-local)",
      "command(git add .*)",
      "command(git commit .*)",
      "command(git status.*)",
      "command(git diff.*)",
      "command(git log.*)",
      "command(git show.*)",
      "command(git rev-parse.*)",
      "command(make overnight-where)"
    ],
    "deny": [
      "command(git push.*)",
      "command(git reset --hard.*)",
      "command(rm -rf.*)",
      "command(sudo .*)",
      "command(curl .*)",
      "command(wget .*)",
      "command(make deploy.*)",
      "command(make publish.*)",
      "command(make release.*)",
      "command(make db-.*)",
      "command(make infra-.*)",
      "read_url(*)",
      "execute_url(*)",
      "mcp(*)",
      "command(make serve.*)",
      "command(make dev.*)",
      "command(make start.*)",
      "command(make destroy.*)",
      "command(make clean.*)",
      "command(aws .*)",
      "command(cdk .*)",
      "command(terraform .*)",
      "command(npx .*)",
      "command(npm install.*)",
      "command(npm ci.*)",
      "command(pip install.*)",
      "command(pip3 install.*)"
    ],
    "ask": [
      "command(*)"
    ]
  }
}
