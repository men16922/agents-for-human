*.log
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
!/evidence/**/*.log
!/evidence/**/*.db
!/evidence/**/*.sqlite
!/evidence/**/*.sqlite3

