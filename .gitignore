.DS_Store
.AppleDouble/
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Keep source, lockfiles, shared agent config, evidence and submissions tracked.
# Do not blanket-ignore evidence/, media files, .claude/, .codex/ or .kiro/.
