# Local development only. make init-env generates independent random local secrets.
POSTGRES_PASSWORD=generated-by-make-init-env
REDIS_PASSWORD=generated-by-make-init-env
JWT_SECRET=generated-by-make-init-env
COOKIE_SECRET=generated-by-make-init-env
# Future model integration; blank values do not block the offline foundation.
AWS_PROFILE=
AWS_REGION=
REHEARSAL_MODEL_ID=
# CW03 per-run admission budget and explicit provider rates (USD per million tokens).
# Leave blank until the selected model/region rates and spend scope are confirmed.
REHEARSAL_MODEL_BUDGET_USD=
REHEARSAL_PRICE_INPUT=
REHEARSAL_PRICE_OUTPUT=
REHEARSAL_PRICE_CACHE_READ=
REHEARSAL_PRICE_CACHE_WRITE=
REHEARSAL_RATE_SOURCE=
# Admission limits shared by all B3 roles (not a guarantee of provider billing).
REHEARSAL_MAX_TOTAL_TOKENS=100000
REHEARSAL_MAX_MODEL_CALLS=12
REHEARSAL_MAX_TOOL_CALLS=24
