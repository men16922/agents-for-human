{
  "name": "rehearsal-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web",
    "services/medusa"
  ],
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "check:web": "npm run check --workspace=@rehearsal/web",
    "build:web": "npm run build --workspace=@rehearsal/web",
    "test:browser": "playwright test",
    "dev:web": "npm run dev --workspace=@rehearsal/web",
    "medusa:build": "npm run build --workspace=@rehearsal/medusa",
    "medusa:migrate": "npm run migrate --workspace=@rehearsal/medusa",
    "medusa:start": "npm run start --workspace=@rehearsal/medusa"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "ajv": "8.20.0",
    "qs": "6.16.0",
    "bullmq": "5.81.4"
  }
}
